# Dependencias y paquetes
vendor/
node_modules/

# Archivos temporales de bloqueo de Office (se crean al abrir un .pptx/.docx)
~$*.pptx
~$*.docx

# Configuración con credenciales reales (usar config/config.example.php como base)
# src/Config.php contiene solo defaults de desarrollo local; no eliminar si no hay secretos
.env
.env.*
*.secret

# Logs y temporales
*.log
*.tmp
*.cache
/tmp/

# Base de datos local
*.sql.bak
*.dump

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# IDE y editores
.vscode/
.idea/
*.swp
*.swo

# Claude Code (internal)
.claude/

# Archivos de caché PHP
*.php~

# MariaDB / MySQL binarios locales (no deben ir al repo)
/mariadb/

# Caché de Python (microservicio de visión)
__pycache__/
*.pyc

# Guion del pitch (privado del equipo, no publicar)
docs/guion-pitch.md
docs/guion-pitch-10min.md
docs/presentacion/VigIA-Pitch-Equipo80.docx
docs/presentacion/VigIA-Pitch10min-Equipo80.docx
