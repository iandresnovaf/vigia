.DS_Store
Thumbs.db
desktop.ini

# IDE y editores
.vscode/
.idea/
*.swp
*.swo

# Claude Code (internal)
.claude/

# Archivos de caché PHP
*.php~

# MariaDB / MySQL binarios locales (no deben ir al repo)
/mariadb/
